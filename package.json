{
  "name": "dsh-ai-recorder",
  "version": "0.1.1",
  "description": "AI 录音卡(CB08/QS668)后端：BLE 音频/文件接收 → 可插拔 STT 转写 → 工作/总结模式 agent 处理 → MD 笔记",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc <2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.0.1-rc <2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "typecheck": "node ../../typecheck-tmp/recorder/node_modules/typescript/bin/tsc -p ../../typecheck-tmp/recorder/tsconfig.rc1.json --noEmit",
    "build": "node ../../typecheck-tmp/recorder/build-lib.mjs",
    "build:client": "node ../dsh-c/node_modules/tsdown/dist/run.mjs --config-loader native --config ../../typecheck-tmp/recorder/tsdown.config.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
